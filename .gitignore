## ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Bruger-specifikke filer (skal aldrig deles med andre)
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Byggeresultater og output (Build outputs)
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Oo]bj/
[Oo]ut/
bin/
obj/

# Testresultater
*.trx
*.mdmp
AppPackages/
BundleArtifacts/
TestResult*

# NuGet Pakker (Hentes automatisk via restore)
*.nupkg
packages/
!packages/repositories.config

# Lokale miljøvariabler og hemmeligheder
.env
.env.local
.env.*.local

# Generelle OS systemfiler
.DS_Store
Thumbs.db
desktop.ini

# Word-låsefiler (oprettes når et dokument er åbent)
~$*
