@startuml Hydac_Objektmodel

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundCorner 8
skinparam linetype polyline
skinparam nodesep 110
skinparam ranksep 70
skinparam padding 3
skinparam titleFontStyle bold

hide circle
hide methods

skinparam class {
    BackgroundColor White
    BorderColor #BBBBBB
    ArrowColor #444444
    FontColor Black
    AttributeFontColor Black
}

title Hydac Objektmodel

class "m1: Medarbejder" as Medarbejder {
    brugernavn = "Lars Hansen"
    kode = "LH1234"
}

class "b1: Besøg" as Besog {
    dato = "30-09-2026"
    forventet ankomsttid = "12:00"
    forventet afgangstid = "16:00"
    lokale = "X01"
    status = "Tjekket Ind"
    indtjekningskode = "81507192"
}

class "g1: Gæst" as Gaest {
    navn = "Søren Mortensen"
    firma = "Bilka"
}

class "i1: Indtjekning" as Indtjekning {
    indtjekningstid = "12:05"
    sikkerhedsfolder modtaget = "Ja"
}

note right of Indtjekning
    b1 er tjekket ind, men ikke tjekket ud.
    Derfor findes der endnu ingen Udtjekning (0..1).
end note

Medarbejder "1" -right- "0..*" Besog : ansvarlig for
Besog "1" -right- "1" Gaest : omfatter

Besog "1" -- "0..1" Indtjekning : registreres ved

@enduml
